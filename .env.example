# Copy with scripts/setup.py; real values belong only in backend/.env.
# Local access password and signing key. The setup script generates unique values.
AUTH_MODE=password
ACCESS_PASSWORD=
SECRET_KEY=
PUBLIC_BASE_URL=http://localhost:8765
COOKIE_SECURE=false
CORS_ORIGINS=

# Persistent storage, relative to backend/.
DATABASE_URL=sqlite:///./data/replay.db
AUDIO_DIR=./data/audio
LOG_DIR=./data/logs
FFMPEG_EXECUTABLE=ffmpeg

# No paid services are called during installation or when viewing demo records.
# Real live transcription requires DashScope and your own key.
ASR_PROVIDER=dashscope
ASR_MODEL=paraformer-realtime-v2
ALIYUN_DASHSCOPE_API_KEY=
OCR_PROVIDER=mock
LLM_PROVIDER=mock
LLM_FAST_PROVIDER=
LLM_MOCK_FALLBACK=false

# Generic OpenAI-compatible model endpoint: use LLM_PROVIDER=openai.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Native provider alternatives; configure only the ones you use.
DEEPSEEK_API_KEY=
DEEPSEEK_API_KEY_BACKUP=
DEEPSEEK_MODEL=
DEEPSEEK_FAST_MODEL=
ARK_API_KEY=
DOUBAO_MODEL=
QWEN_API_KEY=
QWEN_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
HUNYUAN_API_KEY=
HUNYUAN_MODEL=

# Optional capture and analysis. Enabling AI features can incur provider charges.
DOUYIN_COOKIE=
RECORD_VIDEO=false
AUTOPILOT_ENABLED=false
AUTO_EMOTION=false
REALTIME_CORRECTION_ENABLED=false
REALTIME_REVIEW_ENABLED=false
EMOTION_CONTEXT_ENABLED=false
DANMAKU_ANSWER_ENABLED=false
V2_AUTO_ENABLED=false
FOCUS_ENABLED=false
MEDIA_RETENTION_DAYS=0
LLM_INPUT_PRICE_PER_MILLION=0
LLM_OUTPUT_PRICE_PER_MILLION=0

# Optional Tencent COS; leave empty to keep media locally.
COS_REGION=
COS_BUCKET=
COS_SECRET_ID=
COS_SECRET_KEY=

# Optional integrations. Empty tokens reject requests.
SIGNAL_TOKEN=
PARTNER_TOKEN=
INTEGRATION_LOOPBACK_ONLY=true

# Optional Studio SSO; use AUTH_MODE=studio only with your own compatible platform.
STUDIO_JWT_SECRET=
STUDIO_ME_URL=
PLATFORM_URL=
